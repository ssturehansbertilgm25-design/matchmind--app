// MatchMind — datamodell.
//
// PostgreSQL i både utveckling och drift. Rollen, intensiteten och flaggtypen lagras som
// String med dokumenterade värden i stället för Prisma-enum: det håller schemat portabelt
// och gör att nya värden kan läggas till utan en enum-migration i produktion.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Club {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users     User[]
  teamPlans TeamPlan[]
  invites   Invite[]
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  /// FOUNDER | COACH | PLAYER
  role         String
  /// null för founders, som står utanför klubbstrukturen
  clubId       String?
  /// Avaktiverade konton kan inte logga in men data och historik finns kvar
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  club             Club?           @relation(fields: [clubId], references: [id], onDelete: SetNull)
  profile          PlayerProfile?  @relation("ProfileUser")
  coachedProfiles  PlayerProfile[] @relation("ProfileCoach")
  sessions         Session[]
  reflections      Reflection[]
  scheduleEntries  ScheduleEntry[]
  flags            Flag[]
  notesAboutMe     CoachNote[]     @relation("NoteAboutPlayer")
  notesIWrote      CoachNote[]     @relation("NoteByCoach")
  sentMessages     Message[]       @relation("MessageFrom")
  receivedMessages Message[]       @relation("MessageTo")
  invitesCreated   Invite[]        @relation("InviteCreatedBy")
  auditEntries     AuditLog[]      @relation("AuditActor")

  @@index([clubId])
  @@index([role])
}

model PlayerProfile {
  id                 String  @id @default(cuid())
  userId             String  @unique
  level              String
  birthYear          Int
  guardianConsent    Boolean @default(false)
  guardianEmail      String?
  coachId            String?
  /// 0–100, andel av schemalagda pass spelaren deltagit i
  trainingAttendance Int     @default(0)

  user  User  @relation("ProfileUser", fields: [userId], references: [id], onDelete: Cascade)
  coach User? @relation("ProfileCoach", fields: [coachId], references: [id], onDelete: SetNull)

  @@index([coachId])
}

model Session {
  id         String   @id @default(cuid())
  /// SHA-256 av klientens token — klartext lagras aldrig
  token      String   @unique
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  userAgent  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Inbjudningar ersätter öppen registrering: konton skapas bara via en länk från en
/// founder (alla roller) eller en tränare (spelare i den egna klubben).
model Invite {
  id          String    @id @default(cuid())
  email       String
  /// FOUNDER | COACH | PLAYER
  role        String
  clubId      String?
  /// SHA-256 av inbjudningstoken
  tokenHash   String    @unique
  createdById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  /// Förifylls i acceptformuläret
  name        String?
  /// Sätts på PlayerProfile när en spelare accepterar
  level       String?
  birthYear   Int?

  club      Club? @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdBy User  @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([clubId])
}

model Reflection {
  id              String   @id @default(cuid())
  playerId        String
  /// 1–5
  mood            Int
  tag             String?
  text            String?
  sharedWithCoach Boolean  @default(false)
  escalated       Boolean  @default(false)
  createdAt       DateTime @default(now())

  player     User        @relation(fields: [playerId], references: [id], onDelete: Cascade)
  aiFeedback AiFeedback?

  @@index([playerId, createdAt])
}

model AiFeedback {
  id           String   @id @default(cuid())
  reflectionId String   @unique
  diagnosis    String
  technique    String
  followup     String
  model        String
  createdAt    DateTime @default(now())

  reflection Reflection @relation(fields: [reflectionId], references: [id], onDelete: Cascade)
}

model ScheduleEntry {
  id          String  @id @default(cuid())
  playerId    String
  /// 0 = måndag ... 6 = söndag
  weekday     Int
  time        String?
  focus       String
  /// Axlar | Ben | Core | Rygg | Helkropp (null = inget styrkepass)
  muscleGroup String?
  /// HIGH | MEDIUM | LOW | REST
  intensity   String

  player User @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, weekday])
  @@index([playerId])
}

model CoachNote {
  id        String   @id @default(cuid())
  coachId   String
  playerId  String
  text      String
  updatedAt DateTime @updatedAt

  coach  User @relation("NoteByCoach", fields: [coachId], references: [id], onDelete: Cascade)
  player User @relation("NoteAboutPlayer", fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([coachId, playerId])
  @@index([playerId])
}

model TeamPlan {
  id        String   @id @default(cuid())
  clubId    String   @unique
  text      String
  updatedAt DateTime @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
}

model Flag {
  id         String    @id @default(cuid())
  playerId   String
  /// ESCALATION | FOLLOWUP | DROPOUT_RISK
  type       String
  /// Aldrig reflektionens innehåll — bara en handlingsanvisning till tränaren.
  reason     String
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  resolvedBy String?

  player User @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, resolvedAt])
}

model Message {
  id         String   @id @default(cuid())
  fromUserId String
  toUserId   String
  text       String
  createdAt  DateTime @default(now())

  from User @relation("MessageFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  to   User @relation("MessageTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([fromUserId, toUserId, createdAt])
}

/// Granskningslogg. Skrivs av founder-åtgärder och av varje break-glass-läsning av en
/// spelares reflektionstext. Raderas aldrig av appen — det finns ingen DELETE-väg i koden.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorEmail String
  /// t.ex. USER_ROLE_CHANGED, CLUB_DELETED, REFLECTION_TEXT_REVEALED
  action     String
  targetType String?
  targetId   String?
  /// Obligatoriskt skäl vid break-glass
  reason     String?
  meta       Json?
  createdAt  DateTime @default(now())

  actor User @relation("AuditActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([action])
  @@index([actorId])
}

/// Bromsar lösenordsgissning. Rensas när inloggningen lyckas.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}
