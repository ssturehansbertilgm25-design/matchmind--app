# Databas — PostgreSQL. Lokalt en egen server, i drift Supabase (se DEPLOY.md).
# I Supabase: DATABASE_URL = transaction pooler (port 6543) + ?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://matchmind:byt-mig@127.0.0.1:5432/matchmind?schema=public"

# Migrationer kör direkt mot databasen, inte via transaction-poolern.
# I Supabase: session pooler (port 5432). Lokalt: samma värde som DATABASE_URL.
DIRECT_URL="postgresql://matchmind:byt-mig@127.0.0.1:5432/matchmind?schema=public"

# Appens publika adress. Används för att bygga inbjudningslänkar — pekar den fel
# hamnar mottagaren på fel domän.
APP_URL="http://localhost:3000"

# Anthropic. Utan nyckel (eller med MOCK_AI=1) kör AI-lagret deterministiska demosvar
# och UI:t visar "AI i demoläge". Allt annat i appen fungerar som vanligt.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
MOCK_AI=1

# Valfritt: kräv den här koden på /setup när founder-kontot skapas. Rekommenderas om appen
# ligger publikt innan du hunnit köra setupen. Ta bort raden när kontot är skapat.
# SETUP_TOKEN=""
