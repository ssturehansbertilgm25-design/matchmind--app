# Databas (SQLite i utveckling). Byt till en postgresql://-URL för Supabase/Postgres
# och ändra provider i prisma/schema.prisma till "postgresql".
DATABASE_URL="file:./dev.db"

# Anthropic. Utan nyckel: låt MOCK_AI=1 stå kvar så körs AI-lagret i demoläge
# med deterministiska exempelsvar.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
MOCK_AI=1
